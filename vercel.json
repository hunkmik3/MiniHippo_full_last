{
  "version": 2,
  "builds": [
    {
      "src": "minihippofuill/aptiskey.com/api/misc/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "minihippofuill/aptiskey.com/api/auth/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "minihippofuill/aptiskey.com/api/devices/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "minihippofuill/aptiskey.com/api/lessons/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "minihippofuill/aptiskey.com/api/practice_results/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "minihippofuill/aptiskey.com/api/practice_sets/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "minihippofuill/aptiskey.com/api/demo/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "minihippofuill/aptiskey.com/api/users/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "minihippofuill/aptiskey.com/api/vstep/[resource]/[action].js",
      "use": "@vercel/node"
    },
    {
      "src": "minihippofuill/aptiskey.com/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/ask",
      "destination": "/minihippofuill/aptiskey.com/api/misc/[action].js?action=ask"
    },
    {
      "source": "/api/upload-audio",
      "destination": "/minihippofuill/aptiskey.com/api/misc/[action].js?action=upload-audio"
    },
    {
      "source": "/api/upload-speaking-recording",
      "destination": "/minihippofuill/aptiskey.com/api/misc/[action].js?action=upload-speaking-recording"
    },
    {
      "source": "/api/github-media",
      "destination": "/minihippofuill/aptiskey.com/api/misc/[action].js?action=github-media"
    },
    {
      "source": "/api/upload-lesson",
      "destination": "/minihippofuill/aptiskey.com/api/misc/[action].js?action=upload-lesson"
    },
    {
      "source": "/api/visitor-count",
      "destination": "/minihippofuill/aptiskey.com/api/misc/[action].js?action=visitor-count"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/minihippofuill/aptiskey.com/api/auth/[action].js?action=:action"
    },
    {
      "source": "/api/devices/:action",
      "destination": "/minihippofuill/aptiskey.com/api/devices/[action].js?action=:action"
    },
    {
      "source": "/api/lessons/:action",
      "destination": "/minihippofuill/aptiskey.com/api/lessons/[action].js?action=:action"
    },
    {
      "source": "/api/practice_results/:action",
      "destination": "/minihippofuill/aptiskey.com/api/practice_results/[action].js?action=:action"
    },
    {
      "source": "/api/practice_sets/:action",
      "destination": "/minihippofuill/aptiskey.com/api/practice_sets/[action].js?action=:action"
    },
    {
      "source": "/api/demo/:action",
      "destination": "/minihippofuill/aptiskey.com/api/demo/[action].js?action=:action"
    },
    {
      "source": "/api/users/:action",
      "destination": "/minihippofuill/aptiskey.com/api/users/[action].js?action=:action"
    },
    {
      "source": "/api/vstep/:resource/:action",
      "destination": "/minihippofuill/aptiskey.com/api/vstep/[resource]/[action].js?resource=:resource&action=:action"
    },
    {
      "source": "/aptis",
      "destination": "/minihippofuill/aptiskey.com/home.html"
    },
    {
      "source": "/vstep",
      "destination": "/minihippofuill/aptiskey.com/vstep_bode.html"
    },
    {
      "source": "/lop-hoc",
      "destination": "/minihippofuill/aptiskey.com/lop_hoc.html"
    },
    {
      "source": "/(.*)",
      "destination": "/minihippofuill/aptiskey.com/$1"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
